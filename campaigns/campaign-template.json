{
  "schema_version": "3.0",
  "campaign_id": "replace-me",
  "status": "test_only",
  "client_name": "Replace with client name",
  "sender": {
    "name": "Replace with sender name"
  },
  "offer": {
    "service": "Describe the approved service in one sentence.",
    "audience": "Describe the intended buyer.",
    "risk_reversal": "Add the approved risk reversal or leave blank.",
    "risk_reversal_variants": [
      {
        "id": "outcome-only",
        "text": "State the approved outcome-based commercial model naturally."
      },
      {
        "id": "fees-tied-to-outcome",
        "text": "Explain briefly that fees are tied to the approved outcome."
      },
      {
        "id": "delivery-and-pricing",
        "text": "Describe what is handled and when the client pays."
      }
    ],
    "cta": "Offer one specific numbered asset or useful next step.",
    "cta_variants": [
      {
        "id": "send-first-idea",
        "text": "Want me to send the 3 ideas I'd test first?"
      },
      {
        "id": "send-short-outline",
        "text": "Should I send over the 3-step outline?"
      },
      {
        "id": "show-starting-approach",
        "text": "Open to seeing the 2 approaches I'd start with?"
      },
      {
        "id": "send-example",
        "text": "Want me to send 3 concrete examples?"
      }
    ],
    "approved_claims": [
      "Only include claims the client has approved."
    ],
    "forbidden_claims": [
      "Do not invent results, guarantees, customers, statistics, or prospect intent."
    ]
  },
  "qualification": {
    "company": {
      "fallback_min_agreeing_fields": 2,
      "fallback_fields": [
        "Company description",
        "Company keywords",
        "Company industry"
      ]
    },
    "contact": {
      "priority_title_patterns": [
        "\\b(?:owner|co-owner|founder|co-founder|founding partner|managing partner)\\b",
        "\\b(?:chief executive officer|ceo|president|partner)\\b",
        "\\b(?:managing director|principal)\\b",
        "\\b(?:vice president|vp|director|head of)\\b"
      ],
      "ready_title_patterns": [
        "\\b(?:owner|co-owner|founder|co-founder|chief executive officer|ceo|president|managing partner|managing director|partner|principal|managing member)\\b"
      ],
      "review_title_patterns": [
        "\\b(?:vice president|vp|director|head of|business development|sales director|commercial director)\\b"
      ],
      "exclude_title_patterns": [
        "\\b(?:assistant|associate|analyst|intern|student|coordinator|co-ordinator|specialist)\\b"
      ],
      "ready_seniorities": [
        "C-Suite",
        "Founder/Owner",
        "Partner",
        "Director"
      ],
      "review_seniorities": [
        "Vice President",
        "Head"
      ]
    },
    "email": {
      "accepted_statuses": [
        "verified",
        "valid"
      ],
      "review_statuses": [
        "catch-all",
        "risky",
        "unknown",
        "unverified"
      ],
      "rejected_statuses": [
        "invalid",
        "bounced",
        "do not email"
      ],
      "missing_status_action": "syntax"
    }
  },
  "personalization": {
    "objective": "Turn a verified website fact into a relevant commercial angle.",
    "output_field": "personalized_pitch",
    "focus_rules_file": "campaign-template-focus.csv",
    "max_words": 14,
    "min_confidence": 0.72,
    "low_confidence_action": "review",
    "banned_phrases": [
      "saw that",
      "i noticed",
      "i came across",
      "quick question",
      "just following up",
      "i'll cut the fluff",
      "2 things // checking in"
    ],
    "blocked_evidence_phrases": [],
    "row_fallback": {
      "enabled": true,
      "fields": [
        {
          "header": "Company description",
          "confidence": 0.82
        },
        {
          "header": "AI One-Liner",
          "confidence": 0.78
        },
        {
          "header": "AI Description",
          "confidence": 0.76
        },
        {
          "header": "Products",
          "confidence": 0.74
        },
        {
          "header": "Service Tags",
          "confidence": 0.73
        },
        {
          "header": "Company keywords",
          "confidence": 0.72
        },
        {
          "header": "Company industry",
          "confidence": 0.72
        }
      ]
    },
    "fallback_copy": {
      "enabled": false,
      "status": "review",
      "allow_unmatched_company": false,
      "allow_single_csv_field": false,
      "allow_explicit_company_exclusions": false,
      "promote_company_review": false,
      "templates": [
        {
          "id": "general-title-fallback",
          "personas": [
            "*"
          ],
          "subject": "Relevant subject",
          "pitch": "Replace with an approved title-based outreach question."
        }
      ]
    },
    "llm_focus": {
      "enabled": false,
      "provider": "claude-code",
      "domains_per_call": 5,
      "write_pitch": true,
      "max_pitch_words": 30,
      "max_nominal_usd": 20,
      "allow_expensive_models": false,
      "icp": "Describe the target companies in plain English, including what they must sell and to whom.",
      "exclusions": "List company types that must never be contacted, for example law firms or associations.",
      "model": "claude-opus-5",
      "effort": "low",
      "max_evidence_chars": 3000,
      "examples": [
        {
          "site": "Midwest executive search in accounting, finance and HR",
          "fit_tier": "core",
          "focus": "executive search",
          "buyer_phrase": "companies hiring senior finance leaders"
        },
        {
          "site": "Business attorneys protecting employers",
          "fit_tier": "exclude",
          "focus": "employment law",
          "buyer_phrase": "employers facing workplace disputes"
        }
      ]
    },
    "angles": [
      {
        "id": "verified-signal",
        "signal_types": [
          "*"
        ],
        "templates": [
          {
            "id": "direct-question",
            "subject": "{{company_short_name}}",
            "pitch": "Could a campaign start more conversations with {{buyer_phrase}}?"
          }
        ]
      }
    ]
  },
  "email": {
    "body": "Hi {{first_name}},\n\n{{personalized_pitch}}\n\n{{risk_reversal}}\n\n{{cta}}\n\n{{sender_name}}",
    "preserve_spintax": true
  },
  "quality": {
    "max_body_words": 90,
    "max_subject_words": 8,
    "max_focus_words": 7,
    "max_buyer_phrase_words": 8,
    "max_source_phrase_words": 5,
    "max_cta_words": 12,
    "max_offer_line_words": 24,
    "opening_words": 4,
    "max_opening_share": 0.45,
    "max_exact_pitch_share": 0.1,
    "max_buyer_phrase_share": null,
    "max_cta_share": 0.3,
    "max_offer_line_share": 0.4,
    "min_rows": 20,
    "repetition_action": "review"
  },
  "output": {
    "append_fields": [
      "personalized_subject",
      "personalized_pitch",
      "personalized_email",
      "personalization_angle",
      "personalization_template",
      "personalization_signal_type",
      "personalization_source_focus",
      "personalization_focus",
      "personalization_buyer_phrase",
      "personalization_focus_rule",
      "personalization_cta_variant",
      "personalization_cta",
      "personalization_offer_variant",
      "personalization_offer_line",
      "personalization_facts",
      "personalization_source",
      "personalization_evidence",
      "personalization_confidence",
      "personalization_quality_flags",
      "personalization_status",
      "personalization_error",
      "company_fit_status",
      "company_fit_tier",
      "company_fit_rule",
      "company_fit_source",
      "company_fit_evidence",
      "company_fit_reason",
      "contact_fit_status",
      "contact_fit_rule",
      "contact_fit_reason",
      "email_fit_status",
      "email_fit_rule",
      "email_fit_reason",
      "company_contact_status",
      "company_contact_rank",
      "company_contact_count",
      "company_contact_reason",
      "outreach_status",
      "outreach_reason"
    ]
  },
  "notes": "Campaign scaffold: replace the offer, claims, CTA, first-email and follow-up templates from the confirmed brief. Draft and approve the whole sequence before production. Example quantities are not approved promises.",
  "sequence": {
    "greeting": "inline",
    "max_followup_words": 55,
    "followups": {
      "followup_2a": "{{cta}}",
      "followup_2b": "{{cta}}",
      "followup_3a": "Would that be useful for you?",
      "followup_3b": "Who would be the right person at {{company_short_name}} to speak to about this?"
    },
    "ps_variants": [
      "p.s. if this isn\u2019t something you\u2019re interested in, just reply \"no thanks\" and I\u2019ll take you off my list.",
      "p.s. if you\u2019d rather I didn\u2019t email you again, just reply \"no thanks\" and I\u2019ll take you off my list.",
      "p.s. if this isn\u2019t relevant to you, just reply \"no thanks\" and I\u2019ll take you off my list."
    ],
    "editorial_replacements": {},
    "company_name_overrides": {},
    "ps_scope": "first_only"
  }
}
