{
  "schema_version": "3.0",
  "campaign_id": "scale-olympus-test",
  "status": "test_only",
  "client_name": "Scale Olympus",
  "sender": {
    "name": "Dylan"
  },
  "offer": {
    "service": "A done-for-you cold email system that books qualified sales calls with B2B decision-makers.",
    "audience": "Owners and commercial leaders at B2B service companies.",
    "risk_reversal": "We'd handle the outreach. There's a small tech fee to launch, then you pay per qualified call.",
    "risk_reversal_variants": [
      {
        "id": "v1-performance",
        "text": "We'd handle the outreach. There's a small tech fee to launch, then you pay per qualified call."
      },
      {
        "id": "v2-done-for-you",
        "text": "We build lists, run outreach and qualify replies. You pay a small tech fee to launch, then a fee per qualified call."
      },
      {
        "id": "v3-small-upfront",
        "text": "A small tech fee gets the campaign live. After that, you only pay for qualified calls."
      }
    ],
    "cta": "I can send over a 25-company sample list for you. Useful?",
    "cta_variants": [
      {
        "id": "send-25-sample",
        "text": "I can send over a 25-company sample list for you. Useful?"
      },
      {
        "id": "build-25-profile",
        "text": "Want me to build a list of 25 companies matching that profile?"
      },
      {
        "id": "send-first-25",
        "text": "Should I send over the first 25 companies I'd target?"
      },
      {
        "id": "map-first-25",
        "text": "I can map 25 companies I'd start with. Want the list?"
      },
      {
        "id": "tailored-25-list",
        "text": "Would a tailored list of 25 companies be useful?"
      },
      {
        "id": "show-first-25",
        "text": "Open to seeing the first 25 companies I'd approach for you?"
      }
    ],
    "approved_claims": [
      "Scale Olympus handles the lists, outreach, and replies.",
      "The commercial model is a small tech fee plus a fee per qualified call delivered."
    ],
    "forbidden_claims": [
      "Do not invent call volumes, client results, guarantees, named customers, or prospect intent."
    ]
  },
  "qualification": {
    "company": {
      "fallback_min_agreeing_fields": 2,
      "fallback_fields": ["Company description", "Company keywords", "Company industry"]
    },
    "contact": {
      "priority_title_patterns": [
        "\\b(?:owner|co-owner|founder|co-founder|founding partner|managing partner)\\b",
        "\\b(?:chief executive officer|ceo|(?<!vice )president|partner)\\b",
        "\\b(?:managing director|principal)\\b",
        "\\b(?:vice president|vp|director|head of)\\b"
      ],
      "ready_title_patterns": [
        "\\b(?:owner|co-owner|founder|co-founder|chief executive officer|ceo|(?<!vice )president|managing partner|managing director|partner|principal|managing member)\\b"
      ],
      "review_title_patterns": [
        "\\b(?:vice president|vp|director|head of|business development|sales director|commercial director)\\b"
      ],
      "exclude_title_patterns": [
        "\\b(?:assistant|associate|analyst|intern|student|coordinator|co-ordinator|specialist)\\b"
      ],
      "ready_seniorities": ["C-Suite", "Founder/Owner", "Partner", "Director", "Vice President"],
      "review_seniorities": ["Head"]
    },
    "email": {
      "accepted_statuses": ["verified", "valid"],
      "review_statuses": ["catch-all", "risky", "unknown", "unverified"],
      "rejected_statuses": ["invalid", "bounced", "do not email"],
      "missing_status_action": "syntax"
    }
  },
  "personalization": {
    "objective": "Use a verified product, service, audience, or specialism to frame a concrete outbound angle.",
    "output_field": "personalized_pitch",
    "focus_rules_file": "scale-olympus-focus.csv",
    "max_words": 14,
    "min_confidence": 0.72,
    "low_confidence_action": "review",
    "banned_phrases": [
      "saw that",
      "i noticed",
      "i came across",
      "quick question",
      "more clients",
      "outbound angle",
      "just following up",
      "i'll cut the fluff",
      "2 things // checking in",
      "worth a quick chat",
      "the model is",
      "& more",
      "and more"
    ],
    "row_fallback": {
      "enabled": true,
      "fields": [
        {"header": "Company description", "confidence": 0.82},
        {"header": "AI One-Liner", "confidence": 0.78},
        {"header": "AI Description", "confidence": 0.76},
        {"header": "Products", "confidence": 0.74},
        {"header": "Service Tags", "confidence": 0.73},
        {"header": "Company keywords", "confidence": 0.72},
        {"header": "Company industry", "confidence": 0.72}
      ]
    },
    "angles": [
      {
        "id": "buyer-conversation-angle",
        "signal_types": ["product", "service", "audience", "specialism", "positioning", "*"],
        "templates": [
          {
            "id": "buyer-speak",
            "subject": "Buyer conversations",
            "pitch": "Would more conversations with {{buyer_phrase}} be useful?"
          },
          {
            "id": "focused-reach",
            "subject": "25 target companies",
            "pitch": "Are you looking to speak with more {{buyer_phrase}}?"
          },
          {
            "id": "useful-reach",
            "subject": "Outbound idea",
            "pitch": "Would speaking with more {{buyer_phrase}} help?"
          },
          {
            "id": "conversation-question",
            "subject": "New conversations",
            "pitch": "Is reaching more {{buyer_phrase}} useful right now?"
          },
          {
            "id": "direct-help",
            "subject": "Target account list",
            "pitch": "Are more conversations with {{buyer_phrase}} a priority?"
          },
          {
            "id": "campaign-audience",
            "subject": "A quick idea",
            "pitch": "Would it help to reach more {{buyer_phrase}}?"
          },
          {
            "id": "priority-question",
            "subject": "More buyer conversations",
            "pitch": "Do you want more conversations with {{buyer_phrase}}?"
          },
          {
            "id": "simple-reach",
            "subject": "A list idea",
            "pitch": "Is it worth reaching more {{buyer_phrase}}?"
          }
        ]
      }
    ]
  },
  "email": {
    "body": "Hi {{first_name}},\n\n{{personalized_pitch}}\n\n{{risk_reversal}}\n\n{{cta}}\n\n{{sender_name}}",
    "preserve_spintax": true
  },
  "quality": {
    "max_body_words": 55,
    "max_subject_words": 5,
    "max_focus_words": 7,
    "max_buyer_phrase_words": 7,
    "max_source_phrase_words": 5,
    "max_cta_words": 12,
    "max_offer_line_words": 24,
    "opening_words": 4,
    "max_opening_share": 0.45,
    "max_exact_pitch_share": 0.1,
    "max_buyer_phrase_share": null,
    "max_cta_share": 0.22,
    "max_offer_line_share": 0.4,
    "min_rows": 20,
    "repetition_action": "review"
  },
  "output": {
    "append_fields": [
      "personalized_subject",
      "personalized_pitch",
      "personalized_email",
      "personalization_angle",
      "personalization_template",
      "personalization_signal_type",
      "personalization_source_focus",
      "personalization_focus",
      "personalization_buyer_phrase",
      "personalization_focus_rule",
      "personalization_cta_variant",
      "personalization_cta",
      "personalization_offer_variant",
      "personalization_offer_line",
      "personalization_facts",
      "personalization_source",
      "personalization_evidence",
      "personalization_confidence",
      "personalization_quality_flags",
      "personalization_status",
      "personalization_error",
      "company_fit_status",
      "company_fit_tier",
      "company_fit_rule",
      "company_fit_source",
      "company_fit_evidence",
      "company_fit_reason",
      "contact_fit_status",
      "contact_fit_rule",
      "contact_fit_reason",
      "email_fit_status",
      "email_fit_rule",
      "email_fit_reason",
      "company_contact_status",
      "company_contact_rank",
      "company_contact_count",
      "company_contact_reason",
      "outreach_status",
      "outreach_reason"
    ]
  },
  "notes": "Test configuration only. Approve the final campaign copy before sending."
}
