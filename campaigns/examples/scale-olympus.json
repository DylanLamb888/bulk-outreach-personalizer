{
  "schema_version": "3.0",
  "campaign_id": "scale-olympus-test",
  "status": "test_only",
  "client_name": "Scale Olympus",
  "sender": {
    "name": "Dylan"
  },
  "offer": {
    "service": "A done-for-you cold email system that books qualified sales calls with B2B decision-makers.",
    "audience": "Owners and commercial leaders at B2B service companies.",
    "risk_reversal": "You pay a small tech fee upfront, then a fee for each qualified call.",
    "risk_reversal_variants": [
      {
        "id": "v1-performance",
        "text": "You pay a small tech fee upfront, then a fee for each qualified call."
      },
      {
        "id": "v2-done-for-you",
        "text": "We handle the lists, outreach and replies for a small tech fee, then charge per qualified call."
      },
      {
        "id": "v3-small-upfront",
        "text": "We charge a small tech fee to get started, then you pay for the qualified calls we deliver."
      }
    ],
    "cta": "Want me to send the 3 buyer segments I'd test?",
    "cta_variants": [
      {
        "id": "send-buyer-segments",
        "text": "Want me to send the 3 buyer segments I'd test?"
      },
      {
        "id": "send-audience-messaging",
        "text": "Should I send over the 2 message angles I'd test first?"
      },
      {
        "id": "show-list-criteria",
        "text": "Open to seeing the 5 list criteria I'd use?"
      },
      {
        "id": "send-example-campaign",
        "text": "Want me to send over a 3-email example campaign?"
      },
      {
        "id": "send-first-list",
        "text": "Should I send over a 20-account sample list?"
      },
      {
        "id": "show-target-companies",
        "text": "Open to seeing the first 10 companies I'd target?"
      }
    ],
    "approved_claims": [
      "Scale Olympus handles the lists, outreach, and replies.",
      "The commercial model is a small tech fee plus a fee per qualified call delivered."
    ],
    "forbidden_claims": [
      "Do not invent call volumes, client results, guarantees, named customers, or prospect intent."
    ]
  },
  "qualification": {
    "company": {
      "fallback_min_agreeing_fields": 2,
      "fallback_fields": ["Company description", "Company keywords", "Company industry"]
    },
    "contact": {
      "priority_title_patterns": [
        "\\b(?:owner|co-owner|founder|co-founder|founding partner|managing partner)\\b",
        "\\b(?:chief executive officer|ceo|president|partner)\\b",
        "\\b(?:managing director|principal)\\b",
        "\\b(?:vice president|vp|director|head of)\\b"
      ],
      "ready_title_patterns": [
        "\\b(?:owner|co-owner|founder|co-founder|chief executive officer|ceo|president|managing partner|managing director|partner|principal|managing member)\\b"
      ],
      "review_title_patterns": [
        "\\b(?:vice president|vp|director|head of|business development|sales director|commercial director)\\b"
      ],
      "exclude_title_patterns": [
        "\\b(?:assistant|associate|analyst|intern|student|coordinator|co-ordinator|specialist)\\b"
      ],
      "ready_seniorities": ["C-Suite", "Founder/Owner", "Partner", "Director"],
      "review_seniorities": ["Vice President", "Head"]
    },
    "email": {
      "accepted_statuses": ["verified", "valid"],
      "review_statuses": ["catch-all", "risky", "unknown", "unverified"],
      "rejected_statuses": ["invalid", "bounced", "do not email"],
      "missing_status_action": "syntax"
    }
  },
  "personalization": {
    "objective": "Use a verified product, service, audience, or specialism to frame a concrete outbound angle.",
    "output_field": "personalized_pitch",
    "focus_rules_file": "scale-olympus-focus.csv",
    "max_words": 14,
    "min_confidence": 0.72,
    "low_confidence_action": "review",
    "banned_phrases": [
      "saw that",
      "i noticed",
      "i came across",
      "quick question",
      "more clients",
      "outbound angle",
      "just following up",
      "i'll cut the fluff",
      "2 things // checking in",
      "worth a quick chat",
      "the model is",
      "& more",
      "and more"
    ],
    "row_fallback": {
      "enabled": true,
      "fields": [
        {"header": "Company description", "confidence": 0.82},
        {"header": "AI One-Liner", "confidence": 0.78},
        {"header": "AI Description", "confidence": 0.76},
        {"header": "Products", "confidence": 0.74},
        {"header": "Service Tags", "confidence": 0.73},
        {"header": "Company keywords", "confidence": 0.72},
        {"header": "Company industry", "confidence": 0.72}
      ]
    },
    "angles": [
      {
        "id": "buyer-conversation-angle",
        "signal_types": ["product", "service", "audience", "specialism", "positioning", "*"],
        "templates": [
          {
            "id": "buyer-speak",
            "subject": "{{company_short_name}} buyers",
            "pitch": "Open to speaking with more {{buyer_phrase}}?"
          },
          {
            "id": "focused-reach",
            "subject": "{{company_short_name}} outreach",
            "pitch": "Could a campaign start more conversations with {{buyer_phrase}}?"
          },
          {
            "id": "useful-reach",
            "subject": "Buyer angles for {{company_short_name}}",
            "pitch": "Would it be useful to reach more {{buyer_phrase}}?"
          },
          {
            "id": "conversation-question",
            "subject": "{{company_short_name}} buyer angles",
            "pitch": "Would more conversations with {{buyer_phrase}} be useful?"
          },
          {
            "id": "direct-help",
            "subject": "{{company_short_name}} outreach idea",
            "pitch": "Could we help you reach more {{buyer_phrase}}?"
          },
          {
            "id": "campaign-audience",
            "subject": "Audience for {{company_short_name}}",
            "pitch": "Open to a campaign aimed at {{buyer_phrase}}?"
          },
          {
            "id": "priority-question",
            "subject": "{{company_short_name}} pipeline",
            "pitch": "Is speaking with more {{buyer_phrase}} a priority?"
          },
          {
            "id": "simple-reach",
            "subject": "{{company_short_name}} lead idea",
            "pitch": "Could outreach to {{buyer_phrase}} be useful?"
          }
        ]
      }
    ]
  },
  "email": {
    "body": "Hi {{first_name}},\n\n{{personalized_pitch}}\n\n{{risk_reversal}}\n\n{{cta}}\n\n{{sender_name}}",
    "preserve_spintax": true
  },
  "quality": {
    "max_body_words": 55,
    "max_subject_words": 7,
    "max_focus_words": 7,
    "max_buyer_phrase_words": 8,
    "max_source_phrase_words": 5,
    "max_cta_words": 12,
    "max_offer_line_words": 24,
    "opening_words": 4,
    "max_opening_share": 0.45,
    "max_exact_pitch_share": 0.1,
    "max_buyer_phrase_share": null,
    "max_cta_share": 0.22,
    "max_offer_line_share": 0.4,
    "min_rows": 20,
    "repetition_action": "review"
  },
  "output": {
    "append_fields": [
      "personalized_subject",
      "personalized_pitch",
      "personalized_email",
      "personalization_angle",
      "personalization_template",
      "personalization_signal_type",
      "personalization_source_focus",
      "personalization_focus",
      "personalization_buyer_phrase",
      "personalization_focus_rule",
      "personalization_cta_variant",
      "personalization_cta",
      "personalization_offer_variant",
      "personalization_offer_line",
      "personalization_facts",
      "personalization_source",
      "personalization_evidence",
      "personalization_confidence",
      "personalization_quality_flags",
      "personalization_status",
      "personalization_error",
      "company_fit_status",
      "company_fit_tier",
      "company_fit_rule",
      "company_fit_source",
      "company_fit_evidence",
      "company_fit_reason",
      "contact_fit_status",
      "contact_fit_rule",
      "contact_fit_reason",
      "email_fit_status",
      "email_fit_rule",
      "email_fit_reason",
      "company_contact_status",
      "company_contact_rank",
      "company_contact_count",
      "company_contact_reason",
      "outreach_status",
      "outreach_reason"
    ]
  },
  "notes": "Test configuration only. Approve the final campaign copy before sending."
}
