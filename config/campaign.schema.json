{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bulk-enrich.local/schemas/campaign.schema.json",
  "title": "Bulk Enrich Campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "status",
    "client_name",
    "sender",
    "offer",
    "qualification",
    "personalization",
    "email",
    "quality",
    "output"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "test_only",
        "approved"
      ]
    },
    "client_name": {
      "type": "string",
      "minLength": 1
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "audience",
        "risk_reversal",
        "cta",
        "approved_claims",
        "forbidden_claims"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "risk_reversal": {
          "type": "string"
        },
        "risk_reversal_variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "focus_rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "uniqueItems": true
        },
        "cta": {
          "type": "string",
          "minLength": 1
        },
        "cta_variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "focus_rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "uniqueItems": true
        },
        "approved_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "forbidden_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company",
        "contact",
        "email"
      ],
      "properties": {
        "company": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fallback_min_agreeing_fields",
            "fallback_fields"
          ],
          "properties": {
            "fallback_min_agreeing_fields": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10
            },
            "fallback_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "priority_title_patterns",
            "ready_title_patterns",
            "review_title_patterns",
            "exclude_title_patterns",
            "ready_seniorities",
            "review_seniorities"
          ],
          "properties": {
            "priority_title_patterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "ready_title_patterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "review_title_patterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "exclude_title_patterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "ready_seniorities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "review_seniorities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted_statuses",
            "review_statuses",
            "rejected_statuses",
            "missing_status_action"
          ],
          "properties": {
            "accepted_statuses": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "review_statuses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "rejected_statuses": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "missing_status_action": {
              "enum": [
                "syntax",
                "review",
                "exclude"
              ]
            }
          }
        }
      }
    },
    "personalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "output_field",
        "focus_rules_file",
        "max_words",
        "min_confidence",
        "low_confidence_action",
        "banned_phrases",
        "angles"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "output_field": {
          "type": "string",
          "minLength": 1
        },
        "focus_rules_file": {
          "type": "string",
          "minLength": 1
        },
        "max_words": {
          "type": "integer",
          "minimum": 5,
          "maximum": 100
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "low_confidence_action": {
          "enum": [
            "review",
            "blank"
          ]
        },
        "banned_phrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blocked_evidence_phrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "row_fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "fields"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "header",
                  "confidence"
                ],
                "properties": {
                  "header": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "fallback_copy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "status",
            "templates"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "status": {
              "enum": [
                "ready",
                "review"
              ]
            },
            "allow_unmatched_company": {
              "type": "boolean"
            },
            "allow_single_csv_field": {
              "type": "boolean"
            },
            "allow_explicit_company_exclusions": {
              "type": "boolean"
            },
            "promote_company_review": {
              "type": "boolean"
            },
            "templates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "personas",
                  "subject",
                  "pitch"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "personas": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pitch": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "angles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "signal_types",
              "templates"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "signal_types": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "templates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "subject",
                    "pitch"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "subject": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pitch": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "llm_focus": {
          "type": "object",
          "description": "Opt-in model classification of each unique company domain. Never per row; cached by domain, provider, complete rendered prompts, and validation inputs.",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "icp": {
              "type": "string",
              "minLength": 1
            },
            "exclusions": {
              "type": "string"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "max_evidence_chars": {
              "type": "integer",
              "minimum": 500,
              "maximum": 12000
            },
            "examples": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "site",
                  "fit_tier",
                  "focus",
                  "buyer_phrase"
                ],
                "properties": {
                  "site": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fit_tier": {
                    "type": "string",
                    "enum": [
                      "core",
                      "secondary",
                      "exclude"
                    ]
                  },
                  "focus": {
                    "type": "string",
                    "minLength": 1
                  },
                  "buyer_phrase": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "provider": {
              "type": "string",
              "enum": [
                "claude-code",
                "codex",
                "api"
              ],
              "description": "claude-code uses the local Claude Code login (default); codex uses the Codex CLI login (live execution not yet verified); both retry subscription throttling three times then stop. api uses the Anthropic SDK."
            },
            "domains_per_call": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "write_pitch": {
              "type": "boolean",
              "description": "Write a factual model opening; unapproved numeric or commercial promises fall back to templates, and offer mechanics require review. False uses approved slot-filled templates."
            },
            "max_pitch_words": {
              "type": "integer",
              "minimum": 10,
              "maximum": 60
            },
            "max_nominal_usd": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Stop new waves once nominal usage reaches this amount; in-flight calls may overshoot. Completed decisions are checkpointed for a subsequent run."
            },
            "allow_expensive_models": {
              "type": "boolean",
              "description": "Required to use Fable or Mythos tier models."
            }
          }
        }
      }
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "preserve_spintax"
      ],
      "properties": {
        "body": {
          "type": "string",
          "minLength": 1
        },
        "preserve_spintax": {
          "type": "boolean"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_body_words",
        "max_subject_words",
        "max_focus_words",
        "max_buyer_phrase_words",
        "max_source_phrase_words",
        "max_cta_words",
        "max_offer_line_words",
        "opening_words",
        "max_opening_share",
        "max_exact_pitch_share",
        "max_buyer_phrase_share",
        "max_cta_share",
        "max_offer_line_share",
        "min_rows",
        "repetition_action"
      ],
      "properties": {
        "max_body_words": {
          "type": "integer",
          "minimum": 10,
          "maximum": 200
        },
        "max_subject_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_focus_words": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "max_buyer_phrase_words": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16
        },
        "max_source_phrase_words": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "max_cta_words": {
          "type": "integer",
          "minimum": 3,
          "maximum": 20
        },
        "max_offer_line_words": {
          "type": "integer",
          "minimum": 3,
          "maximum": 40
        },
        "opening_words": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "max_opening_share": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_exact_pitch_share": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_buyer_phrase_share": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          ]
        },
        "max_cta_share": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_offer_line_share": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "min_rows": {
          "type": "integer",
          "minimum": 2
        },
        "repetition_action": {
          "enum": [
            "warn",
            "review"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_fields"
      ],
      "properties": {
        "append_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "followups"
      ],
      "properties": {
        "greeting": {
          "enum": [
            "inline",
            "paragraph"
          ],
          "default": "inline"
        },
        "followups": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "followup_2a",
            "followup_2b",
            "followup_3a",
            "followup_3b"
          ],
          "properties": {
            "followup_2a": {
              "type": "string",
              "minLength": 1
            },
            "followup_2b": {
              "type": "string",
              "minLength": 1
            },
            "followup_3a": {
              "type": "string",
              "minLength": 1
            },
            "followup_3b": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "neutral_followups": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "followup_2a",
            "followup_2b",
            "followup_3a",
            "followup_3b"
          ],
          "properties": {
            "followup_2a": {
              "type": "string",
              "minLength": 1
            },
            "followup_2b": {
              "type": "string",
              "minLength": 1
            },
            "followup_3a": {
              "type": "string",
              "minLength": 1
            },
            "followup_3b": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ps_variants": {
          "type": "array",
          "description": "Campaign-approved opt-out sentences. New campaign scaffolds use priority, plans and company-relevance wording; wording remains overridable. Placement is controlled by ps_scope.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^p\\.s\\. [^\\r\\n]+$"
          }
        },
        "max_followup_words": {
          "type": "integer",
          "minimum": 10,
          "maximum": 200,
          "default": 55
        },
        "editorial_replacements": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "reason"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "company_name_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "reason"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "ps_scope": {
          "type": "string",
          "enum": [
            "all",
            "first_only"
          ],
          "default": "all",
          "description": "Append P.S. to all messages (legacy default) or first email only."
        }
      }
    }
  }
}
