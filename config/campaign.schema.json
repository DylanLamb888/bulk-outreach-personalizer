{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bulk-enrich.local/schemas/campaign.schema.json",
  "title": "Bulk Enrich Campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "status",
    "client_name",
    "sender",
    "offer",
    "personalization",
    "email",
    "quality",
    "output"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": { "enum": ["test_only", "approved"] },
    "client_name": { "type": "string", "minLength": 1 },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "audience",
        "risk_reversal",
        "cta",
        "approved_claims",
        "forbidden_claims"
      ],
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "risk_reversal": { "type": "string" },
        "cta": { "type": "string", "minLength": 1 },
        "cta_variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "text": { "type": "string", "minLength": 1 }
            }
          },
          "uniqueItems": true
        },
        "approved_claims": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "forbidden_claims": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "personalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "output_field",
        "focus_rules_file",
        "max_words",
        "min_confidence",
        "max_candidate_confidence_drop",
        "low_confidence_action",
        "banned_phrases",
        "angles"
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "output_field": { "type": "string", "minLength": 1 },
        "focus_rules_file": { "type": "string", "minLength": 1 },
        "max_words": { "type": "integer", "minimum": 5, "maximum": 100 },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_candidate_confidence_drop": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "low_confidence_action": { "enum": ["review", "blank"] },
        "banned_phrases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "row_fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "fields"],
          "properties": {
            "enabled": { "type": "boolean" },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["header", "confidence"],
                "properties": {
                  "header": { "type": "string", "minLength": 1 },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        "angles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "signal_types", "templates"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "signal_types": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "templates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "subject", "pitch"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "subject": { "type": "string", "minLength": 1 },
                    "pitch": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "preserve_spintax"],
      "properties": {
        "body": { "type": "string", "minLength": 1 },
        "preserve_spintax": { "type": "boolean" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_body_words",
        "max_subject_words",
        "max_focus_words",
        "max_buyer_phrase_words",
        "max_source_phrase_words",
        "max_cta_words",
        "opening_words",
        "max_opening_share",
        "max_exact_pitch_share",
        "max_buyer_phrase_share",
        "max_cta_share",
        "min_rows",
        "repetition_action"
      ],
      "properties": {
        "max_body_words": { "type": "integer", "minimum": 10, "maximum": 200 },
        "max_subject_words": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_focus_words": { "type": "integer", "minimum": 2, "maximum": 12 },
        "max_buyer_phrase_words": { "type": "integer", "minimum": 2, "maximum": 16 },
        "max_source_phrase_words": { "type": "integer", "minimum": 2, "maximum": 10 },
        "max_cta_words": { "type": "integer", "minimum": 3, "maximum": 20 },
        "opening_words": { "type": "integer", "minimum": 2, "maximum": 8 },
        "max_opening_share": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_exact_pitch_share": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_buyer_phrase_share": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_cta_share": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "min_rows": { "type": "integer", "minimum": 2 },
        "repetition_action": { "enum": ["warn", "review"] }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["append_fields"],
      "properties": {
        "append_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "notes": { "type": "string" }
  }
}
